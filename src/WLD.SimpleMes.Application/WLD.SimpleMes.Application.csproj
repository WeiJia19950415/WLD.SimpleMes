<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <VersionPrefix>1.0.0.0</VersionPrefix>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <AssetTargetFallback>$(AssetTargetFallback);portable-net45+win8+wp8+wpa81;</AssetTargetFallback>
    <AssemblyName>WLD.SimpleMes.Application</AssemblyName>
    <PackageId>WLD.SimpleMes.Application</PackageId>
    <GenerateAssemblyConfigurationAttribute>false</GenerateAssemblyConfigurationAttribute>
    <GenerateAssemblyCompanyAttribute>false</GenerateAssemblyCompanyAttribute>
    <GenerateAssemblyProductAttribute>false</GenerateAssemblyProductAttribute>
    <RootNamespace>WLD.SimpleMes</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Abp" Version="7.4.0" />
    <PackageReference Include="FluentExcel" Version="2.2.0" />
    <PackageReference Include="JHT.Abp.CommonModels" Version="1.0.1" />
    <PackageReference Include="JHT.CommonUtity" Version="1.0.106" />
    <PackageReference Include="Magicodes.IE.Core" Version="2.7.4.5" />
    <PackageReference Include="Magicodes.IE.Excel" Version="2.7.4.5" />
    <PackageReference Include="QRCoder" Version="1.4.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WLD.SimpleMes.Common\WLD.SimpleMes.Common.csproj" />
    <ProjectReference Include="..\WLD.SimpleMes.Core\WLD.SimpleMes.Core.csproj" />
  </ItemGroup>

</Project>

